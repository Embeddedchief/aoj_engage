# ── Database (Postgres — e.g. Neon via the Vercel Marketplace) ──────────────
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Security ─────────────────────────────────────────────────────────────
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set
CRON_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────
APP_URL="https://engage.aojglobal.com"

# ── Email delivery: Brevo (recommended; free plan = 300 emails/day) ──────
# With neither Brevo nor SES configured, the app runs in SIMULATION mode (no real email leaves the system).
BREVO_API_KEY=""
# Optional: one verified sender used for every email (replies still go to the department address)
BREVO_SENDER_EMAIL=""
# Optional: secret for https://<APP_URL>/api/webhooks/brevo?token=<secret> (bounce / spam reports)
BREVO_WEBHOOK_SECRET=""

# ── Alternative: Amazon SES v2 (used only when BREVO_API_KEY is empty) ───
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_FROM_EMAIL="communications@aojglobal.com"
# Optional SES configuration set that publishes delivery/bounce/complaint events to SNS → /api/webhooks/ses
AWS_SES_CONFIGURATION_SET=""
# Comma-separated SNS topic ARNs allowed to post to the webhook
SES_SNS_TOPIC_ARNS=""

# ── Optional AI writing assistant ────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Root administrator (created once by the deployment seed; must change password at first sign-in) ──
# ROOT_ADMIN_NAME="Admin"
# ROOT_ADMIN_EMAIL="samuelab.aoj@gmail.com"
# ROOT_ADMIN_PASSWORD=""
