# ── Database (Postgres — e.g. Neon via the Vercel Marketplace) ──────────────
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Direct (unpooled) connection used for migrations. Neon's Vercel integration sets this automatically.
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# ── Security ─────────────────────────────────────────────────────────────
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set
CRON_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────
APP_URL="https://engage.aojglobal.com"

# ── Email delivery (Amazon SES v2) ───────────────────────────────────────
# Leave AWS_* empty to run in SIMULATION mode (no real email leaves the system).
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_FROM_EMAIL="communications@aojglobal.com"
# Optional SES configuration set that publishes delivery/bounce/complaint events to SNS → /api/webhooks/ses
AWS_SES_CONFIGURATION_SET=""
# Comma-separated SNS topic ARNs allowed to post to the webhook
SES_SNS_TOPIC_ARNS=""

# ── Optional AI writing assistant ────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Seeding ──────────────────────────────────────────────────────────────
# "true" loads sample (fictitious) contacts and history. Never enable in production.
SEED_DEMO_DATA="false"
